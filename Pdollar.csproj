<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Pdollar</AssemblyName>
    <RootNamespace>Pdollar</RootNamespace>
    <!-- Only build our own sources; don't pick up the sample code/resources under $P\. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="pdollar.cs" />
  </ItemGroup>

</Project>
